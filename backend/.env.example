# Porta do servidor (default: 3333)
PORT=3333

# Ambiente: development | test | production (default: development)
NODE_ENV=development

# URL base da API para documentação Swagger (default: http://localhost:3333)
API_URL=http://localhost:3333

# Origem permitida pelo CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# URL de conexão com o MySQL
DATABASE_URL="mysql://root:root@localhost:3306/integrador"

# Chave secreta para assinar os tokens JWT
JWT_SECRET="segredo-integrador-dev"

# --- Envio de e-mail (recuperação de senha) ---
# Sem SMTP configurado, o código é impresso no log apenas em development.
# Veja docs/configuracao-email-recuperacao-senha.md para o passo a passo do Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua-senha-de-app-de-16-caracteres
# MAIL_FROM="Monitoramento Avícola <seuemail@gmail.com>"
